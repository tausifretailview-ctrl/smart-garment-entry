# Copy to .env and fill in. Never commit .env.
# Domain pointing at this server (DNS A record), e.g. wa.ezzyerp.com
WA_DOMAIN=
# Long random secret: run  openssl rand -hex 32  and paste the result.
# Use the same value as the WA_GATEWAY_KEY Supabase secret.
GATEWAY_API_KEY=
# Your Supabase functions base URL, no trailing slash
SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
# Messages per shop per day (ban protection)
MAX_MSGS_PER_DAY=300
