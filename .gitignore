# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Second package managers — CI fails if these files exist. npm only.
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

node_modules
dist
dist-ssr
*.local
.env.test

# Electron build output
release/
# Generated desktop icon (provide build/icon.png; .ico is derived)
build/icon.ico

# Android (Capacitor) — keep project, ignore local/build artifacts
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/
*.keystore
!debug.keystore
android/keystore.properties

# Installers — host on Supabase Storage / CDN; never commit binaries
public/downloads/*.apk
public/downloads/*.exe
!public/downloads/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Nested checkout of this repo that appears inside src/ on some working copies.
# It duplicates every test (doubling failure counts) and is an easy file to edit
# by mistake. Never commit it.
src/smart-garment-entry/
